# ===========================================
# EnQuéGasto - Backend environment
# ===========================================

PORT=3001
NODE_ENV=development

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enquegasto?schema=public"

JWT_SECRET=enquegasto_dev_jwt_secret_cambiar_en_prod_32c
JWT_REFRESH_SECRET=enquegasto_dev_refresh_secret_cambiar_prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URL del frontend SIN barra final
# Local: http://localhost:5173
# Prod:  https://tu-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Orígenes extra CORS (opcionales, separados por coma)
# CORS_ORIGINS=https://otra-url.vercel.app

# ==================== GOOGLE OAUTH ====================
# Console: https://console.cloud.google.com/apis/credentials
# Redirect URI (exacto):
#   https://enquegasto-api.onrender.com/api/auth/google/callback
#   http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ==================== APPLE (opcional) ====================
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_CALLBACK_URL=

# ==================== EMAIL ====================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EnQuéGasto <noreply@enquegasto.cl>
