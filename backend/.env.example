# ===========================================
# EnQuéGasto - Backend environment
# Copia:  cp .env.example .env
# ===========================================

PORT=3001
NODE_ENV=development

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enquegasto?schema=public"

JWT_SECRET=enquegasto_dev_jwt_secret_cambiar_en_prod_32c
JWT_REFRESH_SECRET=enquegasto_dev_refresh_secret_cambiar_prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173

# ==================== GOOGLE OAUTH ====================
# https://console.cloud.google.com/apis/credentials
# Tipo: Aplicación web
# Orígenes JS: http://localhost:5173 , http://localhost:3001
# Redirect: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ==================== APPLE SIGN IN ====================
# Requiere Apple Developer. Ver docs/OAUTH_SETUP.md
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./keys/AuthKey_XXXXX.p8
APPLE_CALLBACK_URL=http://localhost:3001/api/auth/apple/callback

# ==================== EMAIL / SMTP ====================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EnQuéGasto <noreply@enquegasto.cl>
